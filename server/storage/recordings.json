    "turns_count": 11,
    "transcripts": [
      {
        "speaker": "agent",
        "text": "नमस्ते!मैं सहायक हूँ,आपका मल्टीलिंगुअल पब्लिक यूटिलिटी असिस्टेंट। कचरा,पानी,सड़क,बिजली जैसी किसी भी समस्या की शिकायत करें — या अपने पुराने टिकट,रिकॉर्डिंग्स और सिटिज़न पिन के बारे में पूछें।",
        "timestamp": "16:49",
        "turn_id": 1,
        "is_final": true
      },
      {
        "speaker": "agent",
        "text": "आपकी कोई समस्या है या जानकारी चाहिए?",
        "timestamp": "16:50",
        "turn_id": 2,
        "is_final": false
      },
      {
        "speaker": "user",
        "text": "आपकी कोई समस्या है या जानकारी चाहिए कृपया बताएं",
        "timestamp": "16:50",
        "turn_id": 1788693617309,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "क्या आप मुझे अपना क्षेत्र या पता बता सकते हैं",
        "timestamp": "16:50",
        "turn_id": 1788693631113,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "मेरा एड्रेस है",
        "timestamp": "16:50",
        "turn_id": 1788693635902,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "बिजली नहीं आ रही है",
        "timestamp": "16:51",
        "turn_id": 1788693662698,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "धन्यवाद",
        "timestamp": "16:51",
        "turn_id": 1788693668109,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "को भेजी जाएगी 24 से 48 घंटे में निरीक्षण होगा",
        "timestamp": "16:51",
        "turn_id": 1788693682439,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "शिकायत दर्ज करने के लिए कृपया मुझे निम्नलिखित जानकारी दें क्या आप मुझे सही पता बता सकते हैं",
        "timestamp": "16:51",
        "turn_id": 1788693705431,
        "is_final": true
      },
      {
        "speaker": "user",
        "text": "हेलो हेलो हाउ कैन आई एसिस्ट यू टुडे",
        "timestamp": "16:52",
        "turn_id": 1788693744198,
        "is_final": true
      },
      {
